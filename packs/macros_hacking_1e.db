{"_id":"HkMacHackCheck01","name":"Hacking Check","type":"script","scope":"global","command":"const _macTarget = game.settings.get('mosh', 'macroTarget') ?? 'character';\nconst actor = _macTarget === 'token'\n  ? canvas.tokens.controlled[0]?.actor\n  : game.user.character;\nif (!actor) { ui.notifications.warn(\"No character selected.\"); return; }\n\nconst hackingSkill = actor.items.find(i => i.type === \"skill\" && i.name === \"Hacking\");\nconst hasSinclair2 = actor.items.some(i => i.name === \"Sinclair 2\");\nconst hasBurndeck  = actor.getFlag(\"fvtt_mosh_1e_hacking\", \"hasBurndeck\");\nconst hasSatoBliss = actor.getFlag(\"fvtt_mosh_1e_hacking\", \"hasSatoBliss\");\nconst hasMaze      = actor.getFlag(\"fvtt_mosh_1e_hacking\", \"hasMaze\");\n\nconst isExpert = !!hackingSkill;\nconst bonus    = hackingSkill?.system.bonus ?? 0;\nconst intellect = (actor.system.stats.intellect?.value ?? 0)\n                + (actor.system.stats.intellect?.bonus ?? 0);\nconst target = intellect + bonus;\n\nconst r1 = await new Roll(\"1d100\").evaluate();\nlet finalRoll = r1.total;\nlet rollDetails = `${r1.total}`;\nlet rollMode;\n\nif (!isExpert && !hasSinclair2) {\n  const r2 = await new Roll(\"1d100\").evaluate();\n  finalRoll = Math.max(r1.total, r2.total);\n  rollDetails = `${r1.total}, ${r2.total} → took ${finalRoll}`;\n  rollMode = \"Disadvantage [-] — no Expert Hacking\";\n} else if (hasSinclair2) {\n  rollMode = \"Master — Sinclair 2\";\n} else {\n  rollMode = \"Expert\";\n}\n\nconst success = finalRoll <= target;\nconst notes = [];\nif (hasBurndeck)  notes.push(\"⚠ Burndeck active: all nodes at +1 Response\");\nif (hasSatoBliss) notes.push(\"✓ Sato Bliss active: Hardened nodes treated as Secured\");\n\nawait ChatMessage.create({\n  speaker: ChatMessage.getSpeaker({ actor }),\n  content: `<div style=\"border:1px solid #555;padding:4px 6px;border-radius:3px\">\n    <strong>Hacking Check</strong> <em>(${rollMode})</em><br>\n    Rolled <strong>${finalRoll}</strong> [${rollDetails}] vs <strong>${target}</strong>\n    (INT ${intellect} + Hacking ${bonus})<br>\n    <strong style=\"color:${success ? \"green\" : \"red\"}\">${success ? \"✓ SUCCESS\" : \"✗ FAILURE\"}</strong>\n    ${notes.length ? \"<br><small>\" + notes.join(\"<br>\") + \"</small>\" : \"\"}\n  </div>`\n});\n\nif (success) return;\n\n// Maze absorbs this response roll\nif (hasMaze) {\n  await actor.setFlag(\"fvtt_mosh_1e_hacking\", \"hasMaze\", false);\n  await ChatMessage.create({\n    speaker: ChatMessage.getSpeaker({ actor }),\n    content: \"<em>Maze software absorbed this Response roll.</em>\"\n  });\n  return;\n}\n\n// Prompt for network Response modifier then draw Response Table\nconst responseMod = await foundry.applications.api.DialogV2.wait({\n  window: { title: \"Network Response\" },\n  content: `<div style=\"padding:4px\">\n    <label>Network Response modifier (Null=0, up to +5):</label><br>\n    <input type=\"number\" id=\"rmod\" value=\"0\" min=\"0\" max=\"10\"\n           style=\"width:60px;margin-top:4px\">\n  </div>`,\n  buttons: [\n    {\n      action: \"roll\", label: \"Roll Response Table\", default: true,\n      callback: (evt) => parseInt(evt.target.closest(\"form, .dialog-content, .window-content\")?.querySelector(\"#rmod\")?.value) || 0\n    },\n    { action: \"skip\", label: \"Skip\", callback: () => -1 }\n  ]\n});\n\nif (responseMod == null || responseMod < 0) return;\n\nconst pack  = game.packs.get(\"fvtt_mosh_1e_hacking.rolltables_hacking_1e\");\nconst table = await pack?.getDocument(\"ResponseTblHkD10\");\nif (!table) { ui.notifications.warn(\"Response Table not found.\"); return; }\n\nconst responseRoll = await new Roll(`1d10-1+${responseMod}`).evaluate();\nconst responseTotal = responseRoll.total;\nconst responseResult = table.results.find(r => responseTotal >= r.range[0] && responseTotal <= r.range[1]);\nconst responseText = responseResult?.text ?? \"No matching result.\";\nawait ChatMessage.create({\n  speaker: ChatMessage.getSpeaker({ actor }),\n  whisper: ChatMessage.getWhisperRecipients(\"GM\"),\n  content: `<div style=\"border:1px solid #8b1a1a;padding:4px 8px;border-radius:3px\">\n    <strong>Response Table</strong> (roll: ${responseTotal})<br>\n    ${responseText}\n  </div>`,\n});\n","img":"icons/svg/d20-grey.svg","folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"HkMacCoyBoyUse01","name":"Use: CoyBoy","type":"script","scope":"global","command":"const _macTarget = game.settings.get('mosh', 'macroTarget') ?? 'character';\nconst actor = _macTarget === 'token'\n  ? canvas.tokens.controlled[0]?.actor\n  : game.user.character;\nif (!actor) { ui.notifications.warn(\"No character selected.\"); return; }\nconst item = actor.items.find(i => i.name === \"CoyBoy\");\nif (!item) { ui.notifications.warn(\"No CoyBoy in inventory.\"); return; }\nconst roll = await new Roll(\"1d5\").evaluate();\nawait roll.toMessage({\n  speaker: ChatMessage.getSpeaker({ actor }),\n  flavor: `CoyBoy: Reduces this node's Response by ${roll.total}.`\n});\nconst consume = await foundry.applications.api.DialogV2.confirm({\n  window: { title: \"Consume CoyBoy?\" },\n  content: \"<p>Remove CoyBoy from inventory? (Single-use software)</p>\"\n});\nif (consume) await item.delete();\n","img":"icons/svg/item-bag.svg","folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"HkMacIceBrkrUse1","name":"Use: Icebreaker","type":"script","scope":"global","command":"const _macTarget = game.settings.get('mosh', 'macroTarget') ?? 'character';\nconst actor = _macTarget === 'token'\n  ? canvas.tokens.controlled[0]?.actor\n  : game.user.character;\nif (!actor) { ui.notifications.warn(\"No character selected.\"); return; }\nconst item = actor.items.find(i => i.name === \"Icebreaker\");\nif (!item) { ui.notifications.warn(\"No Icebreaker in inventory.\"); return; }\nconst hasUpgrade = await foundry.applications.api.DialogV2.confirm({\n  window: { title: \"Icebreaker\" },\n  content: \"<p>Using the IB++ upgrade?</p><p><small>Standard: Secured → Unsecured<br>IB++: Hardened → Unsecured</small></p>\"\n});\nawait ChatMessage.create({\n  speaker: ChatMessage.getSpeaker({ actor }),\n  content: hasUpgrade\n    ? \"Icebreaker IB++: This Hardened Node is now Unsecured.\"\n    : \"Icebreaker: This Secured Node is now Unsecured.\"\n});\nconst consume = await foundry.applications.api.DialogV2.confirm({\n  window: { title: \"Consume Icebreaker?\" },\n  content: \"<p>Remove Icebreaker from inventory? (Single-use software)</p>\"\n});\nif (consume) await item.delete();\n","img":"icons/svg/item-bag.svg","folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"HkMacKeylogrUse1","name":"Use: Keylogger","type":"script","scope":"global","command":"const _macTarget = game.settings.get('mosh', 'macroTarget') ?? 'character';\nconst actor = _macTarget === 'token'\n  ? canvas.tokens.controlled[0]?.actor\n  : game.user.character;\nif (!actor) { ui.notifications.warn(\"No character selected.\"); return; }\nconst item = actor.items.find(i => i.name === \"Keylogger\");\nif (!item) { ui.notifications.warn(\"No Keylogger in inventory.\"); return; }\nconst roll = await new Roll(\"1d5\").evaluate();\nawait roll.toMessage({\n  speaker: ChatMessage.getSpeaker({ actor }),\n  flavor: `Keylogger: Installation takes ${roll.total} round${roll.total === 1 ? \"\" : \"s\"}. Records all keystrokes on this node once installed.`\n});\nconst consume = await foundry.applications.api.DialogV2.confirm({\n  window: { title: \"Consume Keylogger?\" },\n  content: \"<p>Remove Keylogger from inventory? (Single-use software)</p>\"\n});\nif (consume) await item.delete();\n","img":"icons/svg/item-bag.svg","folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"HkMacMazeUseIt01","name":"Use: Maze","type":"script","scope":"global","command":"const _macTarget = game.settings.get('mosh', 'macroTarget') ?? 'character';\nconst actor = _macTarget === 'token'\n  ? canvas.tokens.controlled[0]?.actor\n  : game.user.character;\nif (!actor) { ui.notifications.warn(\"No character selected.\"); return; }\nconst item = actor.items.find(i => i.name === \"Maze\");\nif (!item) { ui.notifications.warn(\"No Maze in inventory.\"); return; }\nawait actor.setFlag(\"fvtt_mosh_1e_hacking\", \"hasMaze\", true);\nawait ChatMessage.create({\n  speaker: ChatMessage.getSpeaker({ actor }),\n  content: \"Maze activated: the next NetSec Response roll will be ignored automatically.\"\n});\nconst consume = await foundry.applications.api.DialogV2.confirm({\n  window: { title: \"Consume Maze?\" },\n  content: \"<p>Remove Maze from inventory? (Single-use software)</p>\"\n});\nif (consume) await item.delete();\n","img":"icons/svg/item-bag.svg","folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"HkMacRipper2Use1","name":"Use: Ripper2","type":"script","scope":"global","command":"const _macTarget = game.settings.get('mosh', 'macroTarget') ?? 'character';\nconst actor = _macTarget === 'token'\n  ? canvas.tokens.controlled[0]?.actor\n  : game.user.character;\nif (!actor) { ui.notifications.warn(\"No character selected.\"); return; }\nconst item = actor.items.find(i => i.name === \"Ripper2\");\nif (!item) { ui.notifications.warn(\"No Ripper2 in inventory.\"); return; }\nconst roll = await new Roll(\"3d10\").evaluate();\nawait roll.toMessage({\n  speaker: ChatMessage.getSpeaker({ actor }),\n  flavor: `Ripper2: Brute-forcing this node's password — takes ${roll.total} rounds.`\n});\nconst consume = await foundry.applications.api.DialogV2.confirm({\n  window: { title: \"Consume Ripper2?\" },\n  content: \"<p>Remove Ripper2 from inventory? (Single-use software)</p>\"\n});\nif (consume) await item.delete();\n","img":"icons/svg/item-bag.svg","folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"HkMacXmapUseSw01","name":"Use: Xmap","type":"script","scope":"global","command":"const _macTarget = game.settings.get('mosh', 'macroTarget') ?? 'character';\nconst actor = _macTarget === 'token'\n  ? canvas.tokens.controlled[0]?.actor\n  : game.user.character;\nif (!actor) { ui.notifications.warn(\"No character selected.\"); return; }\nconst item = actor.items.find(i => i.name === \"Xmap\");\nif (!item) { ui.notifications.warn(\"No Xmap in inventory.\"); return; }\nawait ChatMessage.create({\n  speaker: ChatMessage.getSpeaker({ actor }),\n  content: \"Xmap: Retrieving complete node map of this network. (Warden: reveal network topology.)\"\n});\nconst consume = await foundry.applications.api.DialogV2.confirm({\n  window: { title: \"Consume Xmap?\" },\n  content: \"<p>Remove Xmap from inventory? (Single-use software)</p>\"\n});\nif (consume) await item.delete();\n","img":"icons/svg/item-bag.svg","folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"HkMacNodeDetect1","name":"Node Detector","type":"script","scope":"global","command":"const _macTarget = game.settings.get('mosh', 'macroTarget') ?? 'character';\nconst actor = _macTarget === 'token'\n  ? canvas.tokens.controlled[0]?.actor\n  : game.user.character;\nif (!actor) { ui.notifications.warn(\"No character selected.\"); return; }\nconst item = actor.items.find(i => i.name === \"Node Detector\");\nif (!item) { ui.notifications.warn(\"No Node Detector in inventory.\"); return; }\nconst hasScout = await foundry.applications.api.DialogV2.confirm({\n  window: { title: \"Node Detector\" },\n  content: \"<p>Does this Node Detector have the Scout upgrade (+500cr)?</p>\"\n});\nawait ChatMessage.create({\n  speaker: ChatMessage.getSpeaker({ actor }),\n  content: hasScout\n    ? \"Node Detector (Scout): All nodes within 50m detected, including Security level and Response modifier.\"\n    : \"Node Detector: All nodes within 50m detected. (Scout upgrade required to reveal Security/Response.)\"\n});\n","img":"icons/svg/d10-grey.svg","folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"HkMacBrickboyArm","name":"Arm Brickboy","type":"script","scope":"global","command":"const _macTarget = game.settings.get('mosh', 'macroTarget') ?? 'character';\nconst actor = _macTarget === 'token'\n  ? canvas.tokens.controlled[0]?.actor\n  : game.user.character;\nif (!actor) { ui.notifications.warn(\"No character selected.\"); return; }\nconst item = actor.items.find(i => i.name === \"Brickboy\");\nif (!item) { ui.notifications.warn(\"No Brickboy in inventory.\"); return; }\nconst trigger = await foundry.applications.api.DialogV2.wait({\n  window: { title: \"Arm Brickboy\" },\n  content: `<div style=\"padding:4px\">\n    <p>What event triggers this Brickboy?</p>\n    <input type=\"text\" id=\"btrig\" style=\"width:100%\"\n           placeholder=\"e.g. door opened, PDA receives message, user logs into terminal\">\n  </div>`,\n  buttons: [\n    {\n      action: \"arm\", label: \"Arm\", default: true,\n      callback: (_e, _b, dialog) => dialog.querySelector(\"#btrig\").value.trim()\n    },\n    { action: \"cancel\", label: \"Cancel\", callback: () => \"\" }\n  ]\n});\nif (!trigger) return;\nawait ChatMessage.create({\n  speaker: ChatMessage.getSpeaker({ actor }),\n  content: `<strong>Brickboy armed.</strong><br>Trigger: <em>${trigger}</em><br>\n    When triggered, connected hardware is fried.`\n});\n","img":"icons/svg/d10-grey.svg","folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"HkMacSwiperSys01","name":"Swiper System","type":"script","scope":"global","command":"const _macTarget = game.settings.get('mosh', 'macroTarget') ?? 'character';\nconst actor = _macTarget === 'token'\n  ? canvas.tokens.controlled[0]?.actor\n  : game.user.character;\nif (!actor) { ui.notifications.warn(\"No character selected.\"); return; }\nconst item = actor.items.find(i => i.name === \"Swiper System\");\nif (!item) { ui.notifications.warn(\"No Swiper System in inventory.\"); return; }\nconst action = await foundry.applications.api.DialogV2.wait({\n  window: { title: \"Swiper System\" },\n  content: \"<p>What are you doing?</p>\",\n  buttons: [\n    { action: \"key\",  label: \"Duplicate keycard\",      default: true, callback: () => \"key\"  },\n    { action: \"cred\", label: \"Steal credits (Credstick upgrade)\", callback: () => \"cred\" },\n    { action: \"info\", label: \"How does it work?\",                  callback: () => \"info\" }\n  ]\n});\nconst msgs = {\n  key:  \"Swiper System: Keycard duplicated. A perfect copy has been printed.\",\n  cred: \"Swiper System (Credstick upgrade): Credentials captured, credits transferred. (Warden: determine amount.)\",\n  info: \"Swiper System: Duplicates any swiped keycard. Credstick upgrade (+2,000cr) steals credits. Remote upgrade (+4,000cr) works up to 20m away.\"\n};\nawait ChatMessage.create({\n  speaker: ChatMessage.getSpeaker({ actor }),\n  content: msgs[action] ?? \"\"\n});\n","img":"icons/svg/d10-grey.svg","folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
