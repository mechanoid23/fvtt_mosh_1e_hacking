{"_id":"HackerLoadoutD10","name":"Loadout: Hacker","img":"icons/svg/d10-grey.svg","description":"<p>Hacker starting loadout. All characters also receive a personal item and basic clothing.</p>","formula":"1d10-1","replacement":true,"displayRoll":true,"results":[{"_id":"HkLd0BaXm9Nq4rTp","type":0,"text":"'Onika' workstation (Icebreaker, Ripper2).","img":"icons/svg/d10-grey.svg","weight":1,"range":[0,0],"drawn":false},{"_id":"HkLd1CvYn8Pk3sWq","type":0,"text":"SMG, Node Detector, Faraday Bag.","img":"icons/svg/d10-grey.svg","weight":1,"range":[1,1],"drawn":false},{"_id":"HkLd2DwZo7Ql2tXr","type":0,"text":"'Burndeck' (CoyBoy), vaccsuit, Stimpak.","img":"icons/svg/d10-grey.svg","weight":1,"range":[2,2],"drawn":false},{"_id":"HkLd3ExAp6Rm1uYs","type":0,"text":"Revolver, crowbar, 'MX Tattler' (Xmap).","img":"icons/svg/d10-grey.svg","weight":1,"range":[3,3],"drawn":false},{"_id":"HkLd4FyBq5Sn0vZt","type":0,"text":"Electronic tool set, stun baton, Brickboy.","img":"icons/svg/d10-grey.svg","weight":1,"range":[4,4],"drawn":false},{"_id":"HkLd5GzCr4To9wAu","type":0,"text":"Assorted tools, 'Burndeck' (Maze).","img":"icons/svg/d10-grey.svg","weight":1,"range":[5,5],"drawn":false},{"_id":"HkLd6HaDsUp3xBv3","type":0,"text":"'Micro-80X' wristcomm, lockpick set, body cam.","img":"icons/svg/d10-grey.svg","weight":1,"range":[6,6],"drawn":false},{"_id":"HkLd7IbEtVq2yCw2","type":0,"text":"Radio jammer, tranq pistol, Snatcher.","img":"icons/svg/d10-grey.svg","weight":1,"range":[7,7],"drawn":false},{"_id":"HkLd8JcFuWr1zDx1","type":0,"text":"Salvage drone, explosives & detonator.","img":"icons/svg/d10-grey.svg","weight":1,"range":[8,8],"drawn":false},{"_id":"HkLd9KdGvXs0AEy0","type":0,"text":"Cat (Synthetic), 'MX Tattler' (Keylogger).","img":"icons/svg/d10-grey.svg","weight":1,"range":[9,9],"drawn":false}],"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"ResponseTblHkD10","name":"Response Table","img":"icons/svg/d10-grey.svg","description":"<p>Roll when a hacker fails a Hacking Check. Add the network's Response modifier to the roll. Results of 9+ all trigger the Tactical Response Team entry.</p>","formula":"1d10-1","replacement":true,"displayRoll":true,"results":[{"_id":"HkRsp0aBxMn9qTpL","type":0,"text":"Warning message. Network's RESPONSE +1.","img":"icons/svg/d10-grey.svg","weight":1,"range":[0,0],"drawn":false},{"_id":"HkRsp1bCyNo8rUqM","type":0,"text":"Device is remotely powered off.","img":"icons/svg/d10-grey.svg","weight":1,"range":[1,1],"drawn":false},{"_id":"HkRsp2cDzOp7sVrN","type":0,"text":"USER ACCOUNT locked out for 1d10 hours.","img":"icons/svg/d10-grey.svg","weight":1,"range":[2,2],"drawn":false},{"_id":"HkRsp3dEAPq6tWsO","type":0,"text":"Security member dispatched to investigate. Arrives in 1d10 rounds.","img":"icons/svg/d10-grey.svg","weight":1,"range":[3,3],"drawn":false},{"_id":"HkRsp4eFBQr5uXtP","type":0,"text":"Network creates dummy directories for the Hacker to search while a security team is sent to investigate.","img":"icons/svg/d10-grey.svg","weight":1,"range":[4,4],"drawn":false},{"_id":"HkRsp5fGCRs4vYuQ","type":0,"text":"The network and all linked networks are locked down for 1d10 hours.","img":"icons/svg/d10-grey.svg","weight":1,"range":[5,5],"drawn":false},{"_id":"HkRsp6gHDSt3wZvR","type":0,"text":"This network and all linked networks increase security level by 1.","img":"icons/svg/d10-grey.svg","weight":1,"range":[6,6],"drawn":false},{"_id":"HkRsp7hIETu2xAwS","type":0,"text":"All linked networks increase RESPONSE +1.","img":"icons/svg/d10-grey.svg","weight":1,"range":[7,7],"drawn":false},{"_id":"HkRsp8iJFUv1yBxT","type":0,"text":"Facility blackout. All non-essential electronics powered down.","img":"icons/svg/d10-grey.svg","weight":1,"range":[8,8],"drawn":false},{"_id":"HkRsp9jKGVw0zCyU","type":0,"text":"TACTICAL RESPONSE TEAM deployed on Seek & Destroy mission. Arrives, heavily armed, in 1d5 rounds.","img":"icons/svg/d10-grey.svg","weight":1,"range":[9,99],"drawn":false}],"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
